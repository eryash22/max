DATABASE_URL=postgresql+psycopg://max_biomedical:change-me@localhost:5432/max_biomedical_dev
SECRET_KEY=replace-with-a-long-random-secret
ENVIRONMENT=production
CORS_ORIGINS=https://your-frontend-domain.example.com
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Device QR Code Management System — frontend origin encoded into generated QR
# images' scan URL (<FRONTEND_BASE_URL>/scan/device/<token>). Must match your real
# production frontend URL, or every newly generated QR code will point at the wrong
# place (existing QR tokens are unaffected — only the URL they resolve to changes).
FRONTEND_BASE_URL=https://your-frontend-domain.example.com
FILE_STORAGE_PATH=./storage
AI_PROVIDER=disabled
AI_MODEL=

# --- Email (SMTP) ---
# The application sends email through one SMTP provider abstraction
# (app/services/email_provider.py). For an Outlook / Microsoft 365 mailbox use the
# values below; no Microsoft Graph / OAuth app registration is required for SMTP.
#
# SMTP_USERNAME is the full mailbox address. SMTP_PASSWORD must be an *app password*
# generated for that account — Microsoft 365 rejects a normal account password when
# modern authentication is enforced, and SMTP AUTH may need enabling for the mailbox
# in the Microsoft 365 admin centre.
#
# Leave SMTP_HOST blank to keep email disabled: send attempts then fail loudly with a
# clear reason rather than silently pretending to succeed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=MAX Biomedical AI

# --- WhatsApp Web automation (Playwright) ---
# See hosting/README.md's "WhatsApp automation" section before enabling this on any
# hosting platform — it needs a persistent browser session and a continuously running
# process, which most serverless/edge platforms cannot provide.
WHATSAPP_AUTOMATION_HEADLESS=true
